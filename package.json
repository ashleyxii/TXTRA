{
  "name": "txtra",
  "version": "1.0.3",
  "description": "TXT in Readable Annotation - Human-friendly structured text format",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "bin": {
    "txtra": "bin/txtra.js",
    "txtra-js": "bin/txtra.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "bench": "node benchmarks/bench.js",
    "prepack": "cp README.md .README.github.md && cp readme_npm.md README.md",
    "postpack": "[ -f .README.github.md ] && mv .README.github.md README.md || true"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashleyxii/TXTRA.git"
  },
  "keywords": [
    "txtra",
    "parser",
    "markdown",
    "mermaid",
    "ast",
    "dsl",
    "structured-text"
  ],
  "author": "ibara",
  "license": "0BSD",
  "bugs": {
    "url": "https://github.com/ashleyxii/TXTRA/issues"
  },
  "homepage": "https://ashleyxii.github.io/TXTRA/"
}
